# Regulatory Monitor — variabili dedicate
# (in aggiunta a SUPABASE_* e SMTP_* già presenti in /root/.env)

# Destinatario delle notifiche (puoi mettere più indirizzi separati da virgola)
MONITOR_EMAIL_TO=info@rescuemanager.eu

# Pianificazione cron + timezone. Default: ogni giorno alle 08:00 (Europe/Rome).
# Esempi: "0 8 * * *" (giornaliero 08:00), "0 8,18 * * *" (08:00 e 18:00),
#         "0 8 * * 1-5" (feriali alle 08:00).
MONITOR_SCHEDULE=0 8 * * *
MONITOR_TZ=Europe/Rome

# Esegui un controllo subito all'avvio del processo (utile dopo un deploy).
MONITOR_RUN_ON_START=false

# Percorso del file env da caricare (default /root/.env)
# ENV_FILE=/root/.env

# ── Già presenti in /root/.env per gli altri servizi (riusate) ───────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=            # in alternativa RESEND_API_KEY
# SMTP_FROM=info@rescuemanager.eu
