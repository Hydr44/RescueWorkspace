# Usage Alerts — variabili dedicate
# (in aggiunta a SUPABASE_* e SMTP_* già presenti in /root/.env)

# Pianificazione cron + timezone. Default: ogni giorno alle 07:00 (Europe/Rome).
USAGE_ALERTS_SCHEDULE=0 7 * * *
USAGE_ALERTS_TZ=Europe/Rome

# Esegui un controllo subito all'avvio del processo (utile dopo un deploy).
USAGE_ALERTS_RUN_ON_START=false

# Percorso del file env da caricare (default /root/.env)
# ENV_FILE=/root/.env

# ── Già presenti in /root/.env per gli altri servizi (riusate) ───────────────
# SUPABASE_URL=                 # prod: https://ienzdgrqalltvkdkuamp.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=                    # in alternativa RESEND_API_KEY
# SMTP_FROM=info@rescuemanager.eu

# ── Test manuale ─────────────────────────────────────────────────────────────
#   npm run dry     # controlla e stampa cosa INVIEREBBE, senza inviare nulla
#   npm run check   # esegue davvero (invia email + registra usage_alerts)
