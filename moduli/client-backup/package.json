{
  "name": "client-backup",
  "version": "1.0.0",
  "description": "RescueManager - Backup giornaliero per-cliente: export dati di ogni org su R2 (JSON per tabella + manifest + zip), con retention",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "run-once": "RUN_ONCE=true node server.js",
    "dry": "RUN_ONCE=true DRY_RUN=true node server.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1011.0",
    "@supabase/supabase-js": "2.99.1",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3"
  }
}
