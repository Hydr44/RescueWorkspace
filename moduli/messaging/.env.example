# moduli/messaging — variabili d'ambiente
# I valori REALI vanno SOLO in /root/.env sul VPS. NON committare i segreti.

# Porta locale del servizio (proxy nginx davanti)
MESSAGING_PORT=3120

# === WhatsApp Cloud API (Meta) ===
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=        # ID del numero (non il numero)
WHATSAPP_WABA_ID=                # WhatsApp Business Account ID
WHATSAPP_TOKEN=                  # token PERMANENTE (segreto)
WHATSAPP_APP_SECRET=             # per validare la firma dei webhook (segreto)
WHATSAPP_VERIFY_TOKEN=           # stringa condivisa col webhook Meta
WHATSAPP_TEMPLATE_STATO=aggiornamento_trasporto
WHATSAPP_TEMPLATE_OTP=codice_firma

# === Riusati da /root/.env (gia' presenti sul VPS) ===
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# UPSTASH_REDIS_REST_URL          # storage OTP (TTL)
# UPSTASH_REDIS_REST_TOKEN
# VPS_API_KEY                     # X-Internal-Key per chiamate server-to-server / trigger DB
