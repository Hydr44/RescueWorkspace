# VPS Control API — variabili (in /root/.env condiviso)

# Token bearer forte (>= 32 char). Generare con: openssl rand -hex 32
VPS_CONTROL_TOKEN=

# Bind: SOLO localhost (nginx fa da reverse proxy TLS). Non esporre la porta.
VPS_CONTROL_HOST=127.0.0.1
VPS_CONTROL_PORT=3910

# Già presenti in /root/.env (riusate per l'audit):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
